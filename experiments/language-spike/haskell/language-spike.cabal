cabal-version: 3.0
name: yuho-language-spike-haskell
version: 0.1.0.0
build-type: Simple

executable yuho-kernel-haskell
  main-is: Main.hs
  other-modules: Json, Sha256, Kernel
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror
  build-depends:
      base ==4.19.2.0
    , array ==0.5.8.0
    , bytestring ==0.12.1.0
    , containers ==0.6.8
    , parsec ==3.1.17.0
    , text ==2.1.1
