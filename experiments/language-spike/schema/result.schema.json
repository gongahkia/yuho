{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yuho.kernel-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "result_schema", "fragment", "input_digest", "status", "provision_kind", "branches", "trace", "diagnostics"],
  "properties": {
    "protocol": {"const": "yuho.kernel-protocol/v1"},
    "request_id": {"type": "string"},
    "result_schema": {"const": "yuho.kernel-result/v1"},
    "fragment": {"const": "ClosedBooleanBranches-v1"},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["true", "false", "rejected"]},
    "provision_kind": {"enum": ["executable", "definition_only", "none"]},
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "status", "trace_ids"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["true", "false"]},
          "trace_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch", "id", "kind", "path", "span", "value", "children"],
        "properties": {
          "branch": {"type": "string"},
          "id": {"type": "string"},
          "kind": {"enum": ["leaf", "all", "any"]},
          "path": {"type": "array", "items": {"type": "string"}},
          "span": {"$ref": "request.schema.json#/$defs/span"},
          "value": {"enum": ["true", "false"]},
          "children": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "request.schema.json#/$defs/diagnostic"}
    }
  }
}
