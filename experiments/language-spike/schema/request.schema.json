{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yuho.kernel-protocol/v1/request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "operation", "input_schema", "fragment", "source", "policy"],
  "properties": {
    "protocol": {"type": "string"},
    "request_id": {"type": "string", "pattern": "^[A-Z][0-9]{2}$"},
    "operation": {"enum": ["evaluate", "validate"]},
    "input_schema": {"type": "string"},
    "fragment": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "text", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^/][^\\\\]*$"},
        "text": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_date", "max_nodes"],
      "properties": {
        "reference_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "max_nodes": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    },
    "program": {"$ref": "#/$defs/provision"},
    "facts": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "parser_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "diagnostics", "source_version"],
      "properties": {
        "accepted": {"type": "boolean"},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "source_version": {"const": "yuho-5.1"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "evaluate"}}},
     "then": {"required": ["program", "facts"], "not": {"required": ["parser_result"]}}},
    {"if": {"properties": {"operation": {"const": "validate"}}},
     "then": {"required": ["parser_result"], "not": {"anyOf": [{"required": ["program"]}, {"required": ["facts"]}]}}}
  ],
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "start_line", "start_col", "end_line", "end_col"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "start_line": {"type": "integer", "minimum": 1},
        "start_col": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "end_col": {"type": "integer", "minimum": 1}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "path", "span"],
      "properties": {
        "kind": {"type": "string"},
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "span": {"$ref": "#/$defs/span"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "span", "definitions", "requirements", "children"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "span": {"$ref": "#/$defs/span"},
        "definitions": {"type": "boolean"},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "children": {"type": "array", "items": {"$ref": "#/$defs/provision"}}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "severity", "path", "span", "parameters"],
      "properties": {
        "code": {"type": "string"},
        "stage": {"type": "string"},
        "severity": {"enum": ["error", "warning", "info"]},
        "path": {"type": "string"},
        "span": {"anyOf": [{"$ref": "#/$defs/span"}, {"type": "null"}]},
        "parameters": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
