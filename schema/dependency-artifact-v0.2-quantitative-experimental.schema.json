{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuho.example/schema/dependency-artifact-v0.2-quantitative-experimental.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifactFormatVersion": {
      "const": "yuho.dependency-artifact/v0.2-quantitative-experimental"
    },
    "artifactDocument": {
      "$ref": "dependency-plan-v0.1-experimental.schema.json"
    },
    "artifactSourceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactExecutionDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactQuantitativeReport": {
      "$ref": "dependency-report-v0.1-experimental.schema.json"
    }
  },
  "required": [
    "artifactFormatVersion",
    "artifactDocument",
    "artifactSourceDigest",
    "artifactExecutionDigest",
    "artifactQuantitativeReport"
  ]
}
