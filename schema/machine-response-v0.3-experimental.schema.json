{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuho.example/schema/machine-response-v0.3-experimental.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "success",
    "operation",
    "input_kind",
    "semantic_profiles",
    "profile_authority",
    "effects",
    "payload",
    "diagnostics",
    "exports"
  ],
  "properties": {
    "format": {
      "const": "yuho.machine-response/v0.3-experimental"
    },
    "success": {
      "type": "boolean"
    },
    "operation": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "semantic_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile_authority": {
      "enum": [
        "native_payload",
        "not_reported_by_operation"
      ]
    },
    "effects": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluation",
            "source_authority",
            "writes"
          ],
          "properties": {
            "evaluation": {
              "enum": [
                "none",
                "requested",
                "not_reported"
              ]
            },
            "source_authority": {
              "enum": [
                "current_sources",
                "embedded_artifact",
                "not_validated"
              ]
            },
            "requested_source_authority": {
              "enum": [
                "current_sources",
                "embedded_artifact"
              ]
            },
            "writes": {
              "enum": [
                "none",
                "new_output_only"
              ]
            }
          }
        }
      ],
      "description": "Successful operations report validated source authority. On failure source_authority is not_validated; requested_source_authority describes only the request. Non-check failures may have evaluated, so evaluation is not_reported."
    },
    "payload": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
