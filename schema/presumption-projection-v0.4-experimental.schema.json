        "registeredConditionSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "registeredConditionKind": {
                "const": "leaf_effective"
              }
            }
          },
          "then": {
            "required": [
              "registeredConditionLeaf"
            ],
            "properties": {
              "registeredConditionLeaf": {
                "type": "string"
              },
              "registeredConditionMembers": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "registeredConditionLeaf": {
                "type": "null"
              },
              "registeredConditionMembers": {
                "minItems": 2
              }
            }
          }
        }
      ]
