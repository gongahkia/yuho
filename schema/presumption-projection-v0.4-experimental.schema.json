{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuho.dev/schema/presumption-projection-v0.4-experimental.schema.json",
  "title": "Experimental operative registered presumptions",
  "description": "Explicit v0.4 profile. Closed records reject unknown fields. Repeated provenance entries are retained as distinct relationships; cross-object shared sources are legitimate. Structural schema plus SDK semantic/backend validation required. Derived projection is not authoring interchange.",
  "$ref": "#/$defs/presumptionProjection",
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "startLine",
        "startColumn",
        "endLine",
        "endColumn"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceKind"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "sourceKind": {
          "enum": [
            "law",
            "case",
            "other",
            "synthetic"
          ]
        },
        "sourceLocator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceSource"
      ],
      "properties": {
        "referenceSource": {
          "type": "string"
        },
        "referenceSpan": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "nodeKind",
        "nodeLabel",
        "nodeSources"
      ],
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "nodeKind": {
          "enum": [
            "rule",
            "input",
            "all",
            "any"
          ]
        },
        "nodeLabel": {
          "type": "string"
        },
        "nodeQuotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodeCitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodeSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "edgeFrom",
        "edgeTo",
        "edgeKind"
      ],
      "properties": {
        "edgeId": {
          "type": "string"
        },
        "edgeFrom": {
          "type": "string"
        },
        "edgeTo": {
          "type": "string"
        },
        "edgeKind": {
          "enum": [
            "requires",
            "member",
            "exception"
          ]
        }
      }
    },
    "law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lawId",
        "lawRevision",
        "lawNodes",
        "lawEdges",
        "lawScope"
      ],
      "properties": {
        "lawId": {
          "type": "string"
        },
        "lawRevision": {
          "type": "string"
        },
        "lawNodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "lawEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "lawScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeActor",
        "scopeContext"
      ],
      "properties": {
        "scopeActor": {
          "type": "string"
        },
        "scopeContext": {
          "type": "string"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionId",
        "assertionDescription",
        "assertionScope",
        "assertionSources"
      ],
      "properties": {
        "assertionId": {
          "type": "string"
        },
        "assertionDescription": {
          "type": "string"
        },
        "assertionScope": {
          "$ref": "#/$defs/scope"
        },
        "assertionSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "classification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "proved"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "not_proved"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unresolved"
            },
            "reason": {
              "enum": [
                "not_determined",
                "external_decision_pending"
              ]
            }
          }
        }
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessmentId",
        "assessmentInput",
        "assessmentScope",
        "assessmentClassification",
        "assessmentReason",
        "assessmentIssuer",
        "assessmentOrigin",
        "assessmentBasis",
        "assessmentAssertions",
        "assessmentSources"
      ],
      "properties": {
        "assessmentId": {
          "type": "string"
        },
        "assessmentInput": {
          "type": "string"
        },
        "assessmentScope": {
          "$ref": "#/$defs/scope"
        },
        "assessmentClassification": {
          "$ref": "#/$defs/classification"
        },
        "assessmentReason": {
          "type": "string"
        },
        "assessmentIssuer": {
          "type": "string"
        },
        "assessmentOrigin": {
          "enum": [
            "external_assertion",
            "synthetic_fixture"
          ]
        },
        "assessmentBasis": {
          "enum": [
            "case_material",
            "assumption"
          ]
        },
        "assessmentAssertions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assessmentSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisId",
        "analysisTarget",
        "analysisScope",
        "analysisAssessments",
        "analysisReferenceDate"
      ],
      "properties": {
        "analysisId": {
          "type": "string"
        },
        "analysisTarget": {
          "type": "string"
        },
        "analysisScope": {
          "$ref": "#/$defs/scope"
        },
        "analysisAssessments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysisReferenceDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipId",
        "relationshipKind",
        "relationshipFrom",
        "relationshipTo",
        "relationshipComment"
      ],
      "properties": {
        "relationshipId": {
          "type": "string"
        },
        "relationshipKind": {
          "enum": [
            "chronology",
            "support",
            "challenge"
          ]
        },
        "relationshipFrom": {
          "type": "string"
        },
        "relationshipTo": {
          "type": "string"
        },
        "relationshipComment": {
          "type": "string"
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotationId",
        "annotationAbout",
        "annotationText",
        "annotationState"
      ],
      "properties": {
        "annotationId": {
          "type": "string"
        },
        "annotationAbout": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotationText": {
          "type": "string"
        },
        "annotationState": {
          "enum": [
            "draft",
            "retained"
          ]
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentationObject",
        "presentationProperties"
      ],
      "properties": {
        "presentationObject": {
          "type": "string"
        },
        "presentationProperties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosticCode",
        "diagnosticLocation",
        "diagnosticObjects",
        "diagnosticMessage"
      ],
      "properties": {
        "diagnosticCode": {
          "type": "string"
        },
        "diagnosticLocation": {
          "type": "string"
        },
        "diagnosticObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnosticMessage": {
          "type": "string"
        }
      }
    },
    "openInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openInputId",
        "openOccurrence",
        "openRule",
        "openScope",
        "openState",
        "openAssessment"
      ],
      "properties": {
        "openInputId": {
          "type": "string"
        },
        "openOccurrence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openRule": {
          "type": "string"
        },
        "openScope": {
          "$ref": "#/$defs/scope"
        },
        "openState": {
          "enum": [
            "missing",
            "unresolved"
          ]
        },
        "openAssessment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "occurrenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrenceLawDigest",
        "occurrenceTarget",
        "occurrenceScope",
        "occurrenceAuthoredNode",
        "occurrenceAuthoredRule",
        "occurrenceEdges"
      ],
      "properties": {
        "occurrenceLawDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "occurrenceTarget": {
          "type": "string"
        },
        "occurrenceScope": {
          "$ref": "#/$defs/scope"
        },
        "occurrenceAuthoredNode": {
          "type": "string"
        },
        "occurrenceAuthoredRule": {
          "type": "string"
        },
        "occurrenceEdges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationRunSnapshot",
        "observationProfile",
        "observationCategory",
        "observationAuthoredObject",
        "observationAuthoredPath",
        "observationOriginalKernelId",
        "observationOriginalBranchId"
      ],
      "properties": {
        "observationRunSnapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observationProfile": {
          "const": "RegisteredPresumptionDerivations-v1"
        },
        "observationCategory": {
          "enum": [
            "requirement",
            "rule",
            "exception",
            "effective_leaf",
            "derivation",
            "registered_condition"
          ]
        },
        "observationAuthoredObject": {
          "type": "string"
        },
        "observationAuthoredPath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observationOriginalKernelId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "observationOriginalBranchId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originKind",
        "originRole",
        "originAuthoredObjects"
      ],
      "properties": {
        "originKind": {
          "enum": [
            "authored",
            "projection_generated"
          ]
        },
        "originRole": {
          "type": "string"
        },
        "originAuthoredObjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingState",
        "bindingAssessment",
        "bindingSupplied",
        "bindingReason"
      ],
      "properties": {
        "bindingState": {
          "enum": [
            "selected",
            "alternative",
            "missing"
          ]
        },
        "bindingAssessment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bindingSupplied": {
          "anyOf": [
            {
              "$ref": "#/$defs/classification"
            },
            {
              "type": "null"
            }
          ]
        },
        "bindingReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "projectionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectedNodeId",
        "projectedNodeKind",
        "projectedNodeRole",
        "projectedNodeLabel",
        "projectedNodeOrigin",
        "projectedNodeOccurrence",
        "projectedNodeObservation",
        "projectedNodeSelected",
        "projectedNodeBinding",
        "projectedNodeComputed",
        "projectedNodeEvaluation",
        "projectedNodeSkipReason",
        "projectedNodeBranchReason"
      ],
      "properties": {
        "projectedNodeId": {
          "type": "string",
          "pattern": "^p-[a-z-]+-[0-9a-f]{64}$"
        },
        "projectedNodeKind": {
          "enum": [
            "authored",
            "occurrence",
            "observation",
            "generated_source"
          ]
        },
        "projectedNodeRole": {
          "type": "string"
        },
        "projectedNodeLabel": {
          "type": "string"
        },
        "projectedNodeOrigin": {
          "$ref": "#/$defs/origin"
        },
        "projectedNodeOccurrence": {
          "anyOf": [
            {
              "$ref": "#/$defs/occurrenceIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectedNodeObservation": {
          "anyOf": [
            {
              "$ref": "#/$defs/observationIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectedNodeSelected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectedNodeBinding": {
          "anyOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectedNodeComputed": {
          "anyOf": [
            {
              "enum": [
                "satisfied",
                "not_satisfied",
                "unresolved"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "projectedNodeEvaluation": {
          "enum": [
            "not_applicable",
            "not_requested",
            "evaluated",
            "not_evaluated"
          ]
        },
        "projectedNodeSkipReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectedNodeBranchReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "projectedNodeKind": {
                "const": "authored"
              }
            }
          },
          "then": {
            "properties": {
              "projectedNodeComputed": {
                "type": "null"
              },
              "projectedNodeEvaluation": {
                "const": "not_applicable"
              },
              "projectedNodeOccurrence": {
                "type": "null"
              },
              "projectedNodeObservation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "projectedNodeKind": {
                "const": "occurrence"
              }
            }
          },
          "then": {
            "properties": {
              "projectedNodeOccurrence": {
                "$ref": "#/$defs/occurrenceIdentity"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "projectedNodeKind": {
                "const": "observation"
              }
            }
          },
          "then": {
            "properties": {
              "projectedNodeObservation": {
                "$ref": "#/$defs/observationIdentity"
              },
              "projectedNodeBinding": {
                "type": "null"
              },
              "projectedNodeEvaluation": {
                "enum": [
                  "evaluated",
                  "not_evaluated"
                ]
              }
            }
          }
        }
      ]
    },
    "projectionEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectedEdgeId",
        "projectedEdgeFrom",
        "projectedEdgeTo",
        "projectedEdgeKind",
        "projectedEdgeSemantics",
        "projectedEdgeOrigin",
        "projectedEdgeOriginalSource"
      ],
      "properties": {
        "projectedEdgeId": {
          "type": "string",
          "pattern": "^p-[a-z-]+-[0-9a-f]{64}$"
        },
        "projectedEdgeFrom": {
          "type": "string",
          "pattern": "^p-[a-z-]+-[0-9a-f]{64}$"
        },
        "projectedEdgeTo": {
          "type": "string",
          "pattern": "^p-[a-z-]+-[0-9a-f]{64}$"
        },
        "projectedEdgeKind": {
          "enum": [
            "requires",
            "member",
            "exception",
            "chronology",
            "support",
            "challenge",
            "instance_of",
            "selected_assessment",
            "assessment_input",
            "assessment_assertion",
            "assessment_source",
            "law_source",
            "assertion_source",
            "annotation_about",
            "analysis_target",
            "analysis_selection",
            "relationship_subject",
            "relationship_object",
            "contains",
            "observes",
            "generated_span",
            "original_source",
            "presumption_target",
            "trigger",
            "rebuttal",
            "registration_analysis",
            "condition_member",
            "leaf_effective_reference",
            "effective_input",
            "direct_assessment",
            "effective_to_downstream",
            "registration_derivation",
            "route_to_effective",
            "resolved_condition_input",
            "observes_downstream",
            "observes_condition"
          ]
        },
        "projectedEdgeSemantics": {
          "enum": [
            "law_structure",
            "descriptive",
            "occurrence_structure",
            "projection",
            "assessment_selection",
            "assessment_binding",
            "provenance",
            "observation",
            "generated_provenance",
            "registered_derivation"
          ]
        },
        "projectedEdgeOrigin": {
          "$ref": "#/$defs/origin"
        },
        "projectedEdgeOriginalSource": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "generatedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedSourceId",
        "generatedSourceKind",
        "generatedSourceText",
        "generatedSourceObjects"
      ],
      "properties": {
        "generatedSourceId": {
          "type": "string"
        },
        "generatedSourceKind": {
          "enum": [
            "generated_law_projection",
            "generated_assessment_projection",
            "generated_presumption_compilation"
          ]
        },
        "generatedSourceText": {
          "type": "string"
        },
        "generatedSourceObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "identityMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityKernelId",
        "identityKind",
        "identityAuthoredIds"
      ],
      "properties": {
        "identityKernelId": {
          "type": "string"
        },
        "identityKind": {
          "type": "string"
        },
        "identityAuthoredIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMappingKernelId",
        "sourceMappingSource",
        "sourceMappingSpan",
        "sourceMappingObjects",
        "sourceMappingOriginals"
      ],
      "properties": {
        "sourceMappingKernelId": {
          "type": "string"
        },
        "sourceMappingSource": {
          "type": "string"
        },
        "sourceMappingSpan": {
          "$ref": "#/$defs/span"
        },
        "sourceMappingObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceMappingOriginals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionGeneratedSources",
        "projectionCompilerIdentities",
        "projectionGeneratedSpans"
      ],
      "properties": {
        "projectionGeneratedSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generatedSource"
          }
        },
        "projectionCompilerIdentities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identityMapping"
          }
        },
        "projectionGeneratedSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceMapping"
          }
        }
      }
    },
    "requirementObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
