executable yuho
  import: yuho-common
  main-is: YuhoMain.hs
  hs-source-dirs: app
  build-depends: yuho ==1.0.0.0

executable yuho-model-bundle
  import: yuho-common
  main-is: ModelBundleMain.hs
  hs-source-dirs: app
  build-depends: yuho ==1.0.0.0

executable yuho-kernel
  import: yuho-common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: yuho ==1.0.0.0

executable yuho-core-conformance
  import: yuho-common
  main-is: CoreConformanceMain.hs
  hs-source-dirs: app
  build-depends: yuho ==1.0.0.0

test-suite yuho-test
  import: yuho-common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules: DependencyChecks, SourceCompositionChecks, InspectionChecks, ComputedInputRepairChecks, ComputedInputChecks, ComputedExample, TemporalAuthoringChecks, TemporalExamples, PresumptionAuthoringChecks, PresumptionExamples, TypedBoundaryChecks, TypedAuthoringChecks, TypedExamples, IndependentLinkedRegressions, LinkedDefinitionChecks, LinkedExample, InteractionChecks, SourceAnchorChecks, SourceAnchors, EditingChecks, Editing, Acknowledgements, HurtChecks, Hurt, CaseViewChecks, ProjectionChecks, AuthoringChecks, Cheating, CaseApplication, ExceptionChecks, TypedFactsChecks, PenaltyChecks, TermsChecks, ProofChecks, PresumptionChecks, ModelBundleChecks, ChangeSetChecks, SurfaceChecks, LegalSurfaceChecks, MultiOffenceChecks, DefinitionSurfaceChecks, ParticipationSurfaceChecks, AttemptSurfaceChecks, ActorExceptionSurfaceChecks, AbetmentSurfaceChecks, CaseSurfaceChecks, SharedCaseFactChecks, LanguageExpansionChecks, ReleaseChecks, CoreYuhoChecks, DiagramChecks, ConformanceChecks, TypedFiniteChecks, CorpusChecks, ReleaseV1Checks
  hs-source-dirs: test examples/computed-input-consumer examples/temporal-consumer examples/presumption-consumer examples/authoring-consumer examples/linked-definitions-consumer examples/typed-authoring-consumer
  build-depends:
      yuho ==1.0.0.0
    , QuickCheck ==2.18.0.0
    , directory ==1.3.8.5
    , process ==1.6.25.0
    , filepath ==1.4.301.0
  if !flag(research-tests)
    buildable: False

test-suite yuho-sdk-test
  import: yuho-common
  type: exitcode-stdio-1.0
  main-is: SDKMain.hs
  hs-source-dirs: test examples/computed-input-consumer examples/temporal-consumer examples/presumption-consumer examples/authoring-consumer examples/linked-definitions-consumer examples/typed-authoring-consumer
