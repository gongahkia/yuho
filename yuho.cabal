source-repository head
  type: git
  location: https://github.com/gongahkia/yuho

flag development
  description: Treat warnings as errors under the pinned development toolchain
  default: False
  manual: True

flag research-tests
  description: Enable tests requiring the complete research reproducibility bundle
  default: False
  manual: True

common yuho-common
  default-language: Haskell2010
  ghc-options: -Wall
  if flag(development)
    ghc-options: -Werror
  build-depends:
      base ==4.19.2.0
    , aeson ==2.3.1.0
    , bytestring ==0.12.1.0
    , containers ==0.6.8
    , crypton ==1.1.5
    , directory ==1.3.8.5
    , process ==1.6.25.0
    , filepath ==1.4.301.0
    , text ==2.1.1
    , time ==1.12.2
    , unix ==2.8.6.0

