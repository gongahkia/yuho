  classify refused-after-warning(worker:ana,org:acme) as not_proved reason "synthetic supplied classification";
  classify assigned-hazardous(org:acme,worker:ben) as proved reason "synthetic supplied classification";
  classify provided-equipment(org:acme,worker:ben) as proved reason "synthetic supplied classification";
  classify refused-after-warning(worker:ben,org:acme) as not_proved reason "synthetic supplied classification";
  classify trained-for(worker:ana,task:scaffolding) as proved reason "synthetic supplied classification";
  classify trained-for(worker:ana,task:welding) as proved reason "synthetic supplied classification";
  classify trained-for(worker:ben,task:scaffolding) as proved reason "synthetic supplied classification";
  classify trained-for(worker:ben,task:welding) as not_proved reason "synthetic supplied classification";
