cabal-version: 3.0
name: yuho-authoring-consumer
version: 0.1.0.0
build-type: Simple
extra-source-files: fixtures/section441.document.json

executable yuho-authoring-consumer
  main-is: Main.hs
  other-modules: Cheating, CaseApplication, Hurt, Acknowledgements, Editing, SourceAnchors, InteractionDemo
  hs-source-dirs: .
  default-language: Haskell2010
  ghc-options: -Wall -Werror
  build-depends:
      base ==4.19.2.0
    , aeson ==2.3.1.0
    , yuho ==1.0.0.0
    , bytestring ==0.12.1.0
    , containers ==0.6.8
    , directory ==1.3.8.5
    , filepath ==1.4.301.0
    , text ==2.1.1
    , time ==1.12.2
