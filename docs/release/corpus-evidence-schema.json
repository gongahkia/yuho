{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gongahkia/yuho/schemas/corpus-evidence/v1.json",
  "title": "Yuho corpus evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "section", "source_snapshot", "encoding", "source_spans", "reviews"],
  "properties": {
    "schema_version": {"const": "yuho.corpus-evidence/v1"},
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdiction", "act", "number"],
      "properties": {
        "jurisdiction": {"type": "string", "minLength": 1},
        "act": {"type": "string", "minLength": 1},
        "number": {"type": "string", "minLength": 1}
      }
    },
    "source_snapshot": {"$ref": "#/$defs/source_snapshot"},
    "encoding": {"$ref": "#/$defs/encoding"},
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_span"}
    },
    "reviews": {
      "type": "array",
      "items": {"$ref": "#/$defs/review"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "raw_sha256", "normalized_sha256", "retrieved_at", "source_url"],
      "properties": {
        "path": {"type": "string", "pattern": "^library/.+/_raw/snapshots/sha256/[a-f0-9]{64}\\.json$"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_sha256": {"$ref": "#/$defs/sha256"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_url": {"type": "string", "format": "uri"},
        "source_version": {"type": "string"}
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yh_path", "yh_sha256", "canonical_ir_sha256", "grammar_version", "compiler_version"],
      "properties": {
        "yh_path": {"type": "string", "pattern": "^library/.+/.+\\.yh$"},
        "yh_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_ir_sha256": {"$ref": "#/$defs/sha256"},
        "grammar_version": {"type": "string", "minLength": 1},
        "compiler_version": {"type": "string", "minLength": 1}
      }
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_sha256", "start_byte", "end_byte", "canonical_ir_paths"],
      "properties": {
        "normalized_sha256": {"$ref": "#/$defs/sha256"},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 1},
        "canonical_ir_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "reviewer", "rubric_version", "decision", "reviewed_inputs", "reviewed_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["automated_triage", "human_review", "independent_approval"]},
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "role"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1},
            "model": {"type": "string"},
            "prompt_sha256": {"$ref": "#/$defs/sha256"},
            "tool_version": {"type": "string"}
          }
        },
        "rubric_version": {"type": "string", "minLength": 1},
        "decision": {"enum": ["approved", "rejected", "flagged", "needs_review"]},
        "reviewed_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normalized_source_sha256", "yh_sha256", "canonical_ir_sha256"],
          "properties": {
            "normalized_source_sha256": {"$ref": "#/$defs/sha256"},
            "yh_sha256": {"$ref": "#/$defs/sha256"},
            "canonical_ir_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "reviewed_at": {"type": "string", "format": "date-time"},
        "independent_of": {"type": "string", "minLength": 1}
      }
    }
  }
}
