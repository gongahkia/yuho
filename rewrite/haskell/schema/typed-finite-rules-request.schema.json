{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuho.example/schema/typed-finite-rules-request-v1.json",
  "title": "Yuho TypedFiniteRules-v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "operation", "input_schema", "fragment", "program", "policy"],
  "properties": {
    "protocol": {"const": "yuho.kernel-protocol/v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"const": "evaluate"},
    "input_schema": {"const": "yuho.kernel-input/v1"},
    "fragment": {"const": "TypedFiniteRules-v1"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_nodes"],
      "properties": {"max_nodes": {"type": "integer", "minimum": 1, "maximum": 2048}}
    },
    "program": {"$ref": "#/$defs/program"}
  },
  "$defs": {
    "term": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["entity", "variable"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "predicate", "arguments"],
          "properties": {
            "kind": {"const": "predicate"}, "predicate": {"type": "string"},
            "arguments": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/term"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "operation", "left", "right"],
          "properties": {
            "kind": {"const": "comparison"},
            "operation": {"enum": ["eq", "neq", "lt", "lte", "gt", "gte", "in-half-open"]},
            "left": {"type": "string"}, "right": {"type": "string"}, "upper": {"type": "string"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "members"],
          "properties": {
            "kind": {"enum": ["all", "any", "at-least", "at-most", "exactly"]},
            "threshold": {"type": "integer", "minimum": 0, "maximum": 2048},
            "members": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/expression"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "member"],
          "properties": {"kind": {"const": "not"}, "member": {"$ref": "#/$defs/expression"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "variable", "entity_type", "member"],
          "properties": {
            "kind": {"enum": ["forall", "exists"]}, "variable": {"type": "string"},
            "entity_type": {"type": "string"}, "member": {"$ref": "#/$defs/expression"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {"kind": {"const": "reference"}, "id": {"type": "string"}}
        }
      ]
    },
    "program": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entity_types", "entities", "predicates", "scalars", "propositions", "requirements", "rules", "priorities", "facts", "values", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "entity_types": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
        "entities": {"type": "array", "maxItems": 256, "items": {"type": "object"}},
        "predicates": {"type": "array", "maxItems": 128, "items": {"type": "object"}},
        "scalars": {"type": "array", "maxItems": 256, "items": {"type": "object"}},
        "propositions": {"type": "array", "maxItems": 256, "items": {"type": "string"}},
        "requirements": {"type": "array", "maxItems": 512, "items": {"type": "object", "required": ["id", "expression"], "properties": {"id": {"type": "string"}, "expression": {"$ref": "#/$defs/expression"}}}},
        "rules": {"type": "array", "maxItems": 128, "items": {"type": "object"}},
        "priorities": {"type": "array", "maxItems": 256, "items": {"type": "object"}},
        "facts": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "values": {"type": "array", "maxItems": 256, "items": {"type": "object"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
