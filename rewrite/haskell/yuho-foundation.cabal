cabal-version: 3.0
name: yuho-foundation
version: 0.1.0.0
build-type: Simple

common foundation
  default-language: Haskell2010
  ghc-options: -Wall -Werror -O1
  build-depends:
      base ==4.19.2.0
    , aeson ==2.3.1.0
    , bytestring ==0.12.1.0
    , containers ==0.6.8
    , crypton ==1.1.5
    , directory ==1.3.8.5
    , filepath ==1.4.301.0
    , text ==2.1.1
    , time ==1.12.2
    , unix ==2.8.6.0

library
  import: foundation
  hs-source-dirs: src
  exposed-modules:
      Yuho.Core.Types
      Yuho.Core.Source
      Yuho.CoreYuho.Types
      Yuho.CoreYuho.Semantics
      Yuho.CoreYuho.Normalize
      Yuho.CoreYuho.Registry
      Yuho.CoreYuho.Conformance
      Yuho.CoreYuho.TypedFinite
      Yuho.Diagram.Types
      Yuho.Diagram.Build
      Yuho.Diagram.Encode
      Yuho.Protocol.Json
      Yuho.Protocol.Decode
      Yuho.Protocol.Encode
      Yuho.Kernel.Validate
      Yuho.Kernel.Evaluate
      Yuho.Kernel.Run
      Yuho.Exception.Types
      Yuho.Exception.Decode
      Yuho.Exception.Validate
      Yuho.Exception.Evaluate
      Yuho.Exception.Encode
      Yuho.Exception.Run
      Yuho.TypedFacts.Types
      Yuho.TypedFacts.Decode
      Yuho.TypedFacts.Validate
      Yuho.TypedFacts.Encode
      Yuho.TypedFacts.Run
      Yuho.PenaltySelection.Types
      Yuho.PenaltySelection.Decode
      Yuho.PenaltySelection.Validate
      Yuho.PenaltySelection.Select
      Yuho.PenaltySelection.Encode
      Yuho.PenaltySelection.Run
      Yuho.PenaltyTerms.Types
      Yuho.PenaltyTerms.Decode
      Yuho.PenaltyTerms.Validate
      Yuho.PenaltyTerms.Encode
      Yuho.PenaltyTerms.Run
      Yuho.SuppliedProofStatus.Types
      Yuho.SuppliedProofStatus.Decode
      Yuho.SuppliedProofStatus.Validate
      Yuho.SuppliedProofStatus.Evaluate
      Yuho.SuppliedProofStatus.Select
      Yuho.SuppliedProofStatus.Encode
      Yuho.SuppliedProofStatus.Run
      Yuho.Presumption.Types
      Yuho.Presumption.Decode
      Yuho.Presumption.Validate
      Yuho.Presumption.Resolve
      Yuho.Presumption.Evaluate
      Yuho.Presumption.Encode
      Yuho.Presumption.Run
      Yuho.TypedFiniteRules.Run
      Yuho.ModelBundle.Types
      Yuho.ModelBundle.Json
      Yuho.ModelBundle.Validate
      Yuho.ModelBundle.Package
      Yuho.ModelBundle.Review
      Yuho.ModelBundle.ChangeSet
      Yuho.ModelBundle.Diff
      Yuho.ModelBundle.Run
      Yuho.Surface.Token
      Yuho.Surface.Lexer
      Yuho.Surface.AST
      Yuho.Surface.ActorExceptions
      Yuho.Surface.Abetment
      Yuho.Surface.Case
      Yuho.Surface.CaseFacts
      Yuho.Surface.Parser
      Yuho.Surface.Resolve
      Yuho.Surface.Definitions
      Yuho.Surface.Participation
      Yuho.Surface.Check
      Yuho.Surface.Lower
      Yuho.Surface.Compile
      Yuho.Surface.Explain
      Yuho.Surface.Modules
      Yuho.Surface.Temporal
      Yuho.Surface.Presumption
      Yuho.Surface.TypedFinite
      Yuho.CLI

executable yuho
  import: foundation
  main-is: YuhoMain.hs
  hs-source-dirs: app
  build-depends: yuho-foundation ==0.1.0.0

executable yuho-model-bundle
  import: foundation
  main-is: ModelBundleMain.hs
  hs-source-dirs: app
  build-depends: yuho-foundation ==0.1.0.0

executable yuho-kernel
  import: foundation
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: yuho-foundation ==0.1.0.0

executable yuho-core-conformance
  import: foundation
  main-is: CoreConformanceMain.hs
  hs-source-dirs: app
  build-depends: yuho-foundation ==0.1.0.0

test-suite foundation-test
  import: foundation
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules: ExceptionChecks, TypedFactsChecks, PenaltyChecks, TermsChecks, ProofChecks, PresumptionChecks, ModelBundleChecks, ChangeSetChecks, SurfaceChecks, LegalSurfaceChecks, MultiOffenceChecks, DefinitionSurfaceChecks, ParticipationSurfaceChecks, AttemptSurfaceChecks, ActorExceptionSurfaceChecks, AbetmentSurfaceChecks, CaseSurfaceChecks, SharedCaseFactChecks, LanguageExpansionChecks, ReleaseChecks, CoreYuhoChecks, DiagramChecks, ConformanceChecks
  hs-source-dirs: test
  build-depends:
      yuho-foundation ==0.1.0.0
    , QuickCheck ==2.18.0.0
    , directory ==1.3.8.5
    , filepath ==1.4.301.0
