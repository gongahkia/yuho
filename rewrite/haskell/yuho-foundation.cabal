cabal-version: 3.0
name: yuho-foundation
version: 0.1.0.0
build-type: Simple

common foundation
  default-language: Haskell2010
  ghc-options: -Wall -Werror -O1
  build-depends:
      base ==4.19.2.0
    , aeson ==2.3.1.0
    , bytestring ==0.12.1.0
    , containers ==0.6.8
    , crypton ==1.1.5
    , text ==2.1.1
    , time ==1.12.2

library
  import: foundation
  hs-source-dirs: src
  exposed-modules:
      Yuho.Core.Types
      Yuho.Core.Source
      Yuho.Protocol.Json
      Yuho.Protocol.Decode
      Yuho.Protocol.Encode
      Yuho.Kernel.Validate
      Yuho.Kernel.Evaluate
      Yuho.Kernel.Run

executable yuho-kernel
  import: foundation
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: yuho-foundation ==0.1.0.0

test-suite foundation-test
  import: foundation
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
      yuho-foundation ==0.1.0.0
    , QuickCheck ==2.18.0.0
    , process ==1.6.25.0
    , directory ==1.3.8.5
    , filepath ==1.4.301.0
