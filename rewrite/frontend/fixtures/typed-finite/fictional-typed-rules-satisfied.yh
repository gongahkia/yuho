  classify intends-gain(actor:alex,item:laptop) as proved reason "synthetic supplied classification";
  classify intends-gain(actor:alex,item:phone) as unresolved reason "synthetic unresolved classification";
  classify located-at(item:laptop,place:warehouse) as proved reason "synthetic supplied classification";
