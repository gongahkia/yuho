{
  "$id": "yuho.execution-plan/v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "language": {
      "const": "YuhoSurface-v0.4"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "max_edges": {
          "minimum": 1,
          "type": "integer"
        },
        "max_outputs": {
          "minimum": 1,
          "type": "integer"
        },
        "max_request_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "max_response_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "max_steps": {
          "minimum": 1,
          "type": "integer"
        },
        "max_total_request_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "max_total_response_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_steps",
        "max_edges",
        "max_outputs",
        "max_request_bytes",
        "max_response_bytes",
        "max_total_request_bytes",
        "max_total_response_bytes"
      ],
      "type": "object"
    },
    "outputs": {
      "items": {
        "enum": [
          "assessment::root-status",
          "choice::selected-penalties",
          "basic_terms::selected-terms",
          "enhanced_terms::selected-terms"
        ]
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array",
      "uniqueItems": true
    },
    "plan_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "yuho.execution-plan/v0.1"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "none"
        },
        "court_outcome": {
          "const": "excluded"
        },
        "jurisdiction": {
          "const": "Fictional"
        },
        "review": {
          "const": "none"
        },
        "use": {
          "const": "compiler_fixture"
        }
      },
      "required": [
        "jurisdiction",
        "authority",
        "review",
        "use",
        "court_outcome"
      ],
      "type": "object"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bundle_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "depends_on": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 1,
            "type": "array"
          },
          "gate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "operation": {
                    "enum": [
                      "is",
                      "contains"
                    ]
                  },
                  "output": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "value": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "output",
                  "operation",
                  "value"
                ],
                "type": "object"
              }
            ]
          },
          "id": {
            "enum": [
              "assessment",
              "choice",
              "basic_terms",
              "enhanced_terms"
            ]
          },
          "module_id": {
            "minLength": 1,
            "type": "string"
          },
          "module_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "request_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "variant": {
            "enum": [
              "SuppliedProofStatus-v1",
              "GuardedPenaltySelection-v1",
              "PenaltyTerms-v1"
            ]
          }
        },
        "required": [
          "id",
          "variant",
          "module_id",
          "module_version",
          "request_sha256",
          "bundle_digest",
          "depends_on",
          "gate"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "plan_id",
    "version",
    "language",
    "scope",
    "steps",
    "outputs",
    "limits"
  ],
  "type": "object"
}
