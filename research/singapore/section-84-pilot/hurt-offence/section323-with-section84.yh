// Research-only Singapore candidate chain; every classification comes from a synthetic scenario.
model SingaporePenalCodeSection323WithSection84ResearchPrototype-v1 {
  variant SuppliedProofStatus-v1;
  jurisdiction Singapore;
  purpose research_prototype;
  request H00;
  policy 2026-09-13 1024;

  provenance {
    source src:pc-hurt source_text "research/hurt-section84/short-excerpts.txt";
    source src:synthetic-status synthetic_status "research/hurt-section84/synthetic-status.txt";
    quote q:act "does any act";
    quote q:hurt "bodily pain, disease or infirmity to any person";
    quote q:causation "and does thereby cause hurt";
    quote q:intention "intention of thereby causing hurt";
    quote q:knowledge "knowledge that he is likely thereby to cause hurt";
    quote q:section323-scope "except in the case provided for by section 323A or 334";
    quote q:time "at the time of doing it, by reason of unsoundness of mind";
    quote q:nature "incapable of knowing the nature of the act";
    quote q:wrong_operator "incapable of knowing that what he is doing is wrong";
    quote q:control "completely deprived of any power to control his actions";
    quote q:ordinary "is wrong by the ordinary standards of reasonable and honest persons";
    quote q:law "is wrong as contrary to law";
  }

  annotations {
    burden section107 defence legal balance_of_probabilities;
  }

  scope-assumptions {
    scope-assumption a:outside-section-323A;
    scope-assumption a:outside-section-334;
    scope-assumption a:post-2022-section-84-expression-applicable;
  }

  offence o:voluntary-hurt rule r:section323-candidate program p:section323 path section323 {
    element conduct f:act-performed quote q:act;
    element result f:hurt-caused quote q:hurt;
    element causation f:hurt-caused-by-act quote q:causation;
    element intention f:intention-to-cause-hurt quote q:intention;
    element knowledge f:knowledge-hurt-likely quote q:knowledge;
    any g:section321-fault (f:intention-to-cause-hurt, f:knowledge-hurt-likely);
    all g:voluntary-hurt (f:act-performed, f:hurt-caused, f:hurt-caused-by-act, g:section321-fault);
  }

  exception x:section84 to o:voluntary-hurt rule r:section84 program p:section84 path section84 {
    element unsoundness f:unsoundness-time quote q:time;
    element causation f:nature-causation quote q:time;
    element nature-incapacity f:nature-incapacity quote q:nature;
    element causation f:wrong-causation quote q:time;
    element ordinary-wrongfulness f:ordinary-wrongfulness-incapacity quote q:ordinary support q:wrong_operator;
    element contrary-law-wrongfulness f:contrary-law-incapacity quote q:law support q:wrong_operator;
    element causation f:control-causation quote q:time;
    element control-incapacity f:control-incapacity quote q:control;
    all g:nature (f:nature-causation, f:nature-incapacity);
    all g:wrongfulness (f:wrong-causation, f:ordinary-wrongfulness-incapacity, f:contrary-law-incapacity);
    all g:control (f:control-causation, f:control-incapacity);
    any g:section84-routes (g:nature, g:wrongfulness, g:control);
    all g:section84-requirements (f:unsoundness-time, g:section84-routes);
  }

  outputs {
    hurt_status f:hurt-caused;
    fault_alternative g:section321-fault;
    voluntary_hurt_requirements g:voluntary-hurt;
    section323_candidate_requirements r:section323-candidate;
    nature_route g:nature;
    wrongfulness_route g:wrongfulness;
    control_route g:control;
    section84_requirements g:section84-requirements;
    section84_defeat x:section84;
    final_rule r:section323-candidate;
  }

  limitations {
    "Research POC; synthetic classifications and scope acknowledgements only";
    "No evidence assessment, diagnosis, offence adjudication or court outcome";
    "No case-specific temporal selection, section 323A or section 334 doctrine";
    "No legal advice or sentence determination";
  }
}
