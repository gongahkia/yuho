// Research POC; all scenario classifications are synthetic and externally supplied.
model SingaporePenalCodeStatutoryDefinitionsResearchPrototype-v1 {
  variant SuppliedProofStatus-v1;
  jurisdiction Singapore;
  purpose research_prototype;
  request D00;
  policy 2026-09-13 1024;

  provenance {
    source src:pc-definitions source_text "research/statutory-definitions/short-excerpts.txt";
    source src:synthetic-status synthetic_status "research/statutory-definitions/synthetic-status.txt";
    quote q:bodily-pain "bodily pain";
    quote q:disease "disease";
    quote q:infirmity "infirmity";
    quote q:act "does any act";
    quote q:hurt-causation "and does thereby cause hurt";
    quote q:intention "intention of thereby causing hurt";
    quote q:knowledge "knowledge that he is likely thereby to cause hurt";
    quote q:gain "gain by unlawful means of property";
    quote q:gain-property "property";
    quote q:gain-entitlement "not legally entitled";
    quote q:loss "loss by unlawful means of property";
    quote q:loss-property "property";
    quote q:loss-entitlement "legally entitled";
    quote q:intends-gain "intention of causing wrongful gain";
    quote q:intends-loss "intention of causing wrongful loss";
    quote q:dishonest-ordinary "dishonest by the ordinary standards of reasonable and honest persons";
    quote q:knows-dishonest "knows that it is dishonest by those standards";
    quote q:movable "any movable property";
    quote q:possession "out of the possession of any person";
    quote q:consent "without that person’s consent";
    quote q:moves "moves that property";
    quote q:for-taking "in order to such taking";
    quote q:time "at the time of doing it, by reason of unsoundness of mind";
    quote q:nature "incapable of knowing the nature of the act";
    quote q:wrong-operator "incapable of knowing that what he is doing is wrong";
    quote q:control "completely deprived of any power to control his actions";
    quote q:ordinary "is wrong by the ordinary standards of reasonable and honest persons";
    quote q:law "is wrong as contrary to law";
  }

  annotations {
    burden section107 defence legal balance_of_probabilities;
  }

  definitions {
    statutory-definition d:hurt kind hurt-result sections 319 {
      input result f:bodily-pain quote q:bodily-pain;
      input result f:disease quote q:disease;
      input result f:infirmity quote q:infirmity;
      any g:hurt (f:bodily-pain, f:disease, f:infirmity);
      output g:hurt;
    }
    statutory-definition d:voluntarily-causing-hurt kind voluntary-hurt sections 321 {
      input conduct f:act-performed quote q:act;
      input causation f:hurt-caused-by-act quote q:hurt-causation;
      mental-state f:intention-to-cause-hurt kind intention target d:hurt as hurt-result quote q:intention;
      mental-state f:knowledge-hurt-likely kind knowledge target d:hurt as hurt-result quote q:knowledge;
      use d:hurt as hurt-result;
      any g:section321-fault (f:intention-to-cause-hurt, f:knowledge-hurt-likely);
      all g:voluntarily-causing-hurt (f:act-performed, d:hurt, f:hurt-caused-by-act, g:section321-fault);
      output g:voluntarily-causing-hurt;
    }
    statutory-definition d:wrongful-gain kind wrongful-gain sections 23 {
      input circumstance f:gain-by-unlawful-means quote q:gain;
      input circumstance f:gain-of-property quote q:gain-property;
      input circumstance f:gain-without-entitlement quote q:gain-entitlement;
      all g:wrongful-gain (f:gain-by-unlawful-means, f:gain-of-property, f:gain-without-entitlement);
      output g:wrongful-gain;
    }
    statutory-definition d:wrongful-loss kind wrongful-loss sections 23 {
      input circumstance f:loss-by-unlawful-means quote q:loss;
      input circumstance f:loss-of-property quote q:loss-property;
      input circumstance f:loss-of-entitled-property quote q:loss-entitlement;
      all g:wrongful-loss (f:loss-by-unlawful-means, f:loss-of-property, f:loss-of-entitled-property);
      output g:wrongful-loss;
    }
    statutory-definition d:dishonestly kind dishonesty sections 24 {
      mental-state f:intends-wrongful-gain kind intention target d:wrongful-gain as wrongful-gain quote q:intends-gain;
      mental-state f:intends-wrongful-loss kind intention target d:wrongful-loss as wrongful-loss quote q:intends-loss;
      input circumstance f:act-dishonest-ordinary-standards quote q:dishonest-ordinary;
      input knowledge f:knows-act-dishonest-ordinary-standards quote q:knows-dishonest;
      any g:section24-intention (f:intends-wrongful-gain, f:intends-wrongful-loss);
      all g:section24-ordinary (f:act-dishonest-ordinary-standards, f:knows-act-dishonest-ordinary-standards);
      any g:dishonestly (g:section24-intention, g:section24-ordinary);
      output g:dishonestly;
    }
  }

  scope-assumptions {
    scope-assumption a:post-2022-section-84-expression-applicable;
    scope-assumption a:outside-section-323A for o:voluntary-hurt;
    scope-assumption a:outside-section-334 for o:voluntary-hurt;
    scope-assumption a:bounded-section-23-and-24-classifications for o:theft;
  }

  offence o:voluntary-hurt rule r:section323-candidate program p:section323 path section323 sections 321,323 {
    use d:voluntarily-causing-hurt as voluntary-hurt;
    all g:section323-requirements (d:voluntarily-causing-hurt);
  }

  offence o:theft rule r:section379-candidate program p:section379 path section379 sections 378,379 {
    use d:dishonestly as dishonesty;
    element movable-property f:movable-property quote q:movable;
    element possession f:another-possession quote q:possession;
    element consent-absence f:without-consent quote q:consent;
    element movement f:property-moved quote q:moves;
    element movement-for-taking f:moved-for-taking quote q:for-taking;
    all g:theft-requirements (f:movable-property, f:another-possession, f:without-consent, d:dishonestly, f:property-moved, f:moved-for-taking);
  }

  general-exception x:section84 rule r:section84 program p:section84 path section84 sections 84 {
    element unsoundness f:unsoundness-time quote q:time;
    element causation f:nature-causation quote q:time;
    element nature-incapacity f:nature-incapacity quote q:nature;
    element causation f:wrong-causation quote q:time;
    element ordinary-wrongfulness f:ordinary-wrongfulness-incapacity quote q:ordinary support q:wrong-operator;
    element contrary-law-wrongfulness f:contrary-law-incapacity quote q:law support q:wrong-operator;
    element causation f:control-causation quote q:time;
    element control-incapacity f:control-incapacity quote q:control;
    all g:nature (f:nature-causation, f:nature-incapacity);
    all g:wrongfulness (f:wrong-causation, f:ordinary-wrongfulness-incapacity, f:contrary-law-incapacity);
    all g:control (f:control-causation, f:control-incapacity);
    any g:section84-routes (g:nature, g:wrongfulness, g:control);
    all g:section84-requirements (f:unsoundness-time, g:section84-routes);
  }

  attach x:section84 to o:voluntary-hurt;
  attach x:section84 to o:theft;

  outputs {
    hurt_definition g:hurt;
    voluntary_hurt_definition g:voluntarily-causing-hurt;
    dishonesty_definition g:dishonestly;
    hurt_candidate g:section323-requirements;
    theft_candidate g:theft-requirements;
    section84_requirements g:section84-requirements;
    section84_defeat x:section84;
    hurt_final r:section323-candidate;
    theft_final r:section379-candidate;
  }

  limitations {
    "Research POC with synthetic externally supplied primitive classifications only";
    "Section 23 alternatives and explanations outside the bounded authored definitions are not executed";
    "Mental-state targets identify concepts; actual wrongful gain or loss is not required for section 24 intention";
    "Section 319 unconsciousness explanation and section 378 explanations are not separately executed";
    "Section 379 punishment, evidence assessment, diagnosis, temporal selection and court outcomes are excluded";
    "No legal advice or conclusion of guilt, acquittal, liability or sentence";
  }
}
