// Bounded executable expressions derived from saved Penal Code materials.
model SingaporePenalCodeCheatingMischiefResearchPrototype-v1 {
  variant SuppliedProofStatus-v1;
  jurisdiction Singapore;
  purpose research_prototype;
  request C00;
  policy 2026-09-13 1024;

  provenance {
    source src:pc-offence-corpus source_text "library/penal-code/sections-415-417-425-426-and-84";
    source src:synthetic-status synthetic_status "research/offence-corpus/synthetic-classifications";
    quote q:deception "by deceiving any person";
    quote q:property-fault "fraudulently or dishonestly induces the person so deceived";
    quote q:property-form "to deliver any property to any person, or to consent that any person shall retain any property";
    quote q:intentional-inducement "intentionally induces the person so deceived";
    quote q:act-or-omission "to do or omit to do anything which he would not do or omit if he were not so deceived";
    quote q:harm "which act or omission causes or is likely to cause damage or harm to that person in body, mind, reputation or property";
    quote q:mischief-intention "with intent to cause wrongful loss or damage to the public or to any person";
    quote q:mischief-knowledge "knowing that he is likely to cause wrongful loss or damage to the public or to any person";
    quote q:destruction "causes the destruction of any property";
    quote q:injurious-change "causes any such change in any property, or in the situation thereof, as destroys or diminishes its value or utility, or affects it injuriously";
    quote q:time "at the time of doing it, by reason of unsoundness of mind";
    quote q:nature "incapable of knowing the nature of the act";
    quote q:wrong-operator "incapable of knowing that what he is doing is wrong";
    quote q:control "completely deprived of any power to control his actions";
    quote q:ordinary "is wrong by the ordinary standards of reasonable and honest persons";
    quote q:law "is wrong as contrary to law";
  }

  annotations {
    burden section107 defence legal balance_of_probabilities;
  }

  scope-assumptions {
    scope-assumption a:post-2022-section-84-expression-applicable;
    scope-assumption a:bounded-section415-text-expression for o:cheating;
    scope-assumption a:section417-candidate-terms-only for o:cheating;
    scope-assumption a:bounded-section425-text-expression for o:mischief;
    scope-assumption a:section426-candidate-terms-only for o:mischief;
  }

  offence o:cheating rule r:section415-candidate program p:section415 path section415 sections 415,417 {
    element conduct f:deception quote q:deception;
    element fault f:property-fraudulent-or-dishonest quote q:property-fault;
    element conduct f:property-delivery-or-retention quote q:property-form;
    element intention f:intentional-inducement quote q:intentional-inducement;
    element conduct f:induced-act-or-omission quote q:act-or-omission;
    element result f:damage-or-harm quote q:harm;
    all g:cheating-property-form (f:property-fraudulent-or-dishonest, f:property-delivery-or-retention);
    all g:cheating-act-harm-form (f:intentional-inducement, f:induced-act-or-omission, f:damage-or-harm);
    any g:cheating-forms (g:cheating-property-form, g:cheating-act-harm-form);
    all g:cheating-requirements (f:deception, g:cheating-forms);
  }

  offence o:mischief rule r:section425-candidate program p:section425 path section425 sections 425,426 {
    element intention f:intent-wrongful-loss-or-damage quote q:mischief-intention;
    element knowledge f:knowledge-likely-wrongful-loss-or-damage quote q:mischief-knowledge;
    element conduct f:destruction-of-property quote q:destruction;
    element result f:injurious-property-change quote q:injurious-change;
    any g:mischief-mental-state (f:intent-wrongful-loss-or-damage, f:knowledge-likely-wrongful-loss-or-damage);
    any g:mischief-property-interference (f:destruction-of-property, f:injurious-property-change);
    all g:mischief-requirements (g:mischief-mental-state, g:mischief-property-interference);
  }

  general-exception x:section84 rule r:section84 program p:section84 path section84 sections 84 {
    element unsoundness f:unsoundness-time quote q:time;
    element causation f:nature-causation quote q:time;
    element nature-incapacity f:nature-incapacity quote q:nature;
    element causation f:wrong-causation quote q:time;
    element ordinary-wrongfulness f:ordinary-wrongfulness-incapacity quote q:ordinary support q:wrong-operator;
    element contrary-law-wrongfulness f:contrary-law-incapacity quote q:law support q:wrong-operator;
    element causation f:control-causation quote q:time;
    element control-incapacity f:control-incapacity quote q:control;
    all g:nature (f:nature-causation, f:nature-incapacity);
    all g:wrongfulness (f:wrong-causation, f:ordinary-wrongfulness-incapacity, f:contrary-law-incapacity);
    all g:control (f:control-causation, f:control-incapacity);
    any g:section84-routes (g:nature, g:wrongfulness, g:control);
    all g:section84-requirements (f:unsoundness-time, g:section84-routes);
  }

  attach x:section84 to o:cheating;
  attach x:section84 to o:mischief;

  outputs {
    cheating_requirements g:cheating-requirements;
    mischief_requirements g:mischief-requirements;
    section84_requirements g:section84-requirements;
    section84_defeat x:section84;
    cheating_final r:section415-candidate;
    mischief_final r:section425-candidate;
  }

  candidate-penalties {
    candidate pen:section417 for offence o:cheating source src:pc-offence-corpus provision 417 {
      one-or-more-of term:section417-alternatives {
        imprisonment term:section417-imprisonment minimum not-stated maximum 3 years;
        fine term:section417-fine currency SGD minimum not-stated maximum unbounded;
      }
    }
    candidate pen:section426 for offence o:mischief source src:pc-offence-corpus provision 426 {
      one-or-more-of term:section426-alternatives {
        imprisonment term:section426-imprisonment minimum not-stated maximum 2 years;
        fine term:section426-fine currency SGD minimum not-stated maximum unbounded;
      }
    }
  }

  limitations {
    "Executable s 415 is limited to the two alternatives visible in the saved statutory summary";
    "Sections 24 and 25 meanings, s 415 explanations and illustrations, and aggravated cheating provisions are contextual or deferred";
    "Executable s 425 is limited to the mental-state and property-interference alternatives quoted here";
    "Section 425 explanations, illustrations, ownership questions and aggravated mischief provisions are contextual or deferred";
    "Sections 417 and 426 are candidate terms only: imprisonment up to the stated maximum, fine, or both";
    "No evidence assessment, legal applicability finding, guilt decision, imposed sentence or court disposition";
  }
}
