// Singapore criminal-law research POC. All classifications and actors are synthetic.
model SingaporePenalCodeIntentionalAidTheftResearchPrototype-v1 {
  variant SuppliedProofStatus-v1;
  jurisdiction Singapore;
  purpose research_prototype;
  request A00;
  policy 2026-09-13 1024;

  provenance {
    source src:pc source_text "research/abetment/penal-code-short-excerpts.txt";
    source src:synthetic synthetic_status "research/abetment/synthetic-status.txt";
    source src:ea contextual "research/abetment/evidence-act-context.txt";
    quote q:intends-gain "intention of causing wrongful gain";
    quote q:intends-loss "intention of causing wrongful loss";
    quote q:gain "gain by unlawful means of property";
    quote q:gain-property "property";
    quote q:gain-entitlement "not legally entitled";
    quote q:loss "loss by unlawful means of property";
    quote q:loss-property "property";
    quote q:loss-entitlement "legally entitled";
    quote q:dishonest-ordinary "dishonest by the ordinary standards of reasonable and honest persons";
    quote q:knows-dishonest "knows that it is dishonest by those standards";
    quote q:movable "any movable property";
    quote q:possession "out of the possession of any person";
    quote q:consent "without that person’s consent";
    quote q:moves "moves that property";
    quote q:for-taking "in order to such taking";
    quote q:aid-act "intentionally aids, by any act";
    quote q:aid-omission "or illegal omission";
    quote q:intends-aid "intentionally aids";
    quote q:aid-link "facilitates the commission thereof";
    quote q:consequence "act abetted is committed in consequence of the abetment";
  }

  annotations { burden none none none not_applicable; }

  party-roles {
    party-role role:principal;
    party-role role:alleged-abettor;
  }

  definitions {
    statutory-definition d:wrongful-gain kind wrongful-gain sections 23 {
      input circumstance f:gain-by-unlawful-means quote q:gain;
      input circumstance f:gain-of-property quote q:gain-property;
      input circumstance f:gain-without-entitlement quote q:gain-entitlement;
      all g:wrongful-gain (f:gain-by-unlawful-means, f:gain-of-property, f:gain-without-entitlement);
      output g:wrongful-gain;
    }
    statutory-definition d:wrongful-loss kind wrongful-loss sections 23 {
      input circumstance f:loss-by-unlawful-means quote q:loss;
      input circumstance f:loss-of-property quote q:loss-property;
      input circumstance f:loss-of-entitled-property quote q:loss-entitlement;
      all g:wrongful-loss (f:loss-by-unlawful-means, f:loss-of-property, f:loss-of-entitled-property);
      output g:wrongful-loss;
    }
    statutory-definition d:dishonestly kind dishonesty sections 24 {
      mental-state f:intends-wrongful-gain kind intention target d:wrongful-gain as wrongful-gain quote q:intends-gain;
      mental-state f:intends-wrongful-loss kind intention target d:wrongful-loss as wrongful-loss quote q:intends-loss;
      input circumstance f:act-dishonest-ordinary-standards quote q:dishonest-ordinary;
      input knowledge f:knows-act-dishonest-ordinary-standards quote q:knows-dishonest;
      any g:section24-intention (f:intends-wrongful-gain, f:intends-wrongful-loss);
      all g:section24-ordinary (f:act-dishonest-ordinary-standards, f:knows-act-dishonest-ordinary-standards);
      any g:dishonestly (g:section24-intention, g:section24-ordinary);
      output g:dishonestly;
    }
  }

  actor-attributions {
    mental-state f:intends-wrongful-gain to role:principal;
    mental-state f:intends-wrongful-loss to role:principal;
    fact f:act-dishonest-ordinary-standards to role:principal;
    mental-state f:knows-act-dishonest-ordinary-standards to role:principal;
    fact f:movable-property to role:principal;
    fact f:another-possession to role:principal;
    fact f:without-consent to role:principal;
    fact f:property-moved to role:principal;
    fact f:moved-for-taking to role:principal;
    mental-state f:intends-aid to role:alleged-abettor;
    fact f:aid-by-act to role:alleged-abettor;
    fact f:aid-by-illegal-omission to role:alleged-abettor;
    relation-fact f:aid-link to rel:aid;
    relation-fact f:consequence to rel:aid;
  }

  scope-assumptions {
    scope-assumption a:no-express-punishment-provision-modelled;
    scope-assumption a:only-intentional-aid-route;
    scope-assumption a:principal-theft-requirements-separately-supplied;
    scope-assumption a:broader-section108-cases-excluded;
    scope-assumption a:punishment-outside-scope;
    scope-assumption a:statutory-expression-supplied;
  }

  offence o:theft rule r:section379-candidate program p:section379 path section379 sections 378,379 {
    use d:dishonestly as dishonesty;
    element movable-property f:movable-property quote q:movable;
    element possession f:another-possession quote q:possession;
    element consent-absence f:without-consent quote q:consent;
    element movement f:property-moved quote q:moves;
    element movement-for-taking f:moved-for-taking quote q:for-taking;
    all g:theft-requirements (f:movable-property, f:another-possession, f:without-consent, d:dishonestly, f:property-moved, f:moved-for-taking);
  }

  participation p:intentional-aid route intentional-aid target o:theft rule r:section109-candidate program p:section109 path section109 sections 107,108,109 {
    relation rel:aid from role:alleged-abettor to role:principal target o:theft status f:aid-link quote q:aid-link;
    element intention f:intends-aid quote q:intends-aid;
    element aid-act f:aid-by-act quote q:aid-act;
    element illegal-omission f:aid-by-illegal-omission quote q:aid-omission;
    element consequence f:consequence quote q:consequence;
    any g:aid-form (f:aid-by-act, f:aid-by-illegal-omission);
    all g:intentional-aid (f:intends-aid, f:aid-link, g:aid-form);
    all g:section109 (g:theft-requirements, g:intentional-aid, f:consequence);
  }

  authorities {
    authority wrongful-concepts PenalCode1871 src:pc section 23;
    authority dishonesty PenalCode1871 src:pc section 24;
    authority theft-conduct PenalCode1871 src:pc section 378;
    authority theft-anchor PenalCode1871 src:pc section 379;
    authority abetment PenalCode1871 src:pc section 107;
    authority abettor PenalCode1871 src:pc section 108;
    authority consequence PenalCode1871 src:pc section 109;
    authority burden-context EvidenceAct1893 src:ea section 107;
  }

  outputs {
    principal_target g:theft-requirements;
    aid_intention f:intends-aid;
    aid_by_act f:aid-by-act;
    aid_illegal_omission f:aid-by-illegal-omission;
    aid_relationship f:aid-link;
    aid_form g:aid-form;
    intentional_aid g:intentional-aid;
    commission_in_consequence f:consequence;
    section109_candidate g:section109;
    final_rule r:section109-candidate;
  }

  limitations {
    "Synthetic actors and externally supplied classifications only";
    "Only the intentional-aid route is modelled; instigation and conspiracy are excluded";
    "Principal theft requirements are separately supplied; broader section 108 cases are excluded";
    "No section 84 assessment is transferred from principal to alleged abettor";
    "No punishment or sentence is selected, and no court outcome is produced";
  }
}
