  general-exception x:section83 rule r:section83 program p:section83 path section83 sections 83 {
    element circumstance f:83-age-10-to-under-12 quote q:83-age-10-to-under-12;
    element circumstance f:83-insufficient-maturity quote q:83-insufficient-maturity;
