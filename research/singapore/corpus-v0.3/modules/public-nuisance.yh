  offence o:public-nuisance rule r:sections268-290-base program p:sections268-290-base path sections268-290-base sections 268,290 {
    element circumstance f:268-common-impact quote q:268-common-impact;
    element circumstance f:290-not-otherwise-punishable quote q:290-not-otherwise-punishable;
    element conduct f:268-does-act quote q:268-does-act;
