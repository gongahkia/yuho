// Yuho Haskell Research Language v0.1: bounded saved-text expressions only.
model SingaporePenalCodeMisappropriationFragmentResearchPrototype-v1 {
  variant SuppliedProofStatus-v1;
  jurisdiction Singapore;
  purpose research_prototype;
  request R01;
  policy 2026-09-13 1024;

  provenance {
    source src:pc-release source_text "library/penal_code/_raw/act.json and saved section statute.yh files";
    source src:release-status synthetic_status "research/singapore/research-release/synthetic classifications";
    quote q:336-act "does any act";
    quote q:336-rash "so rashly as to endanger human life or the personal safety of others";
    quote q:351-gesture "makes any gesture or any preparation";
    quote q:351-intention "intending that such gesture or preparation will cause apprehension of imminent criminal force";
    quote q:351-knowledge "knowing it to be likely that such gesture or preparation will cause apprehension of imminent criminal force";
    quote q:351-apprehension "cause any person present to apprehend imminent use of criminal force";
    quote q:352-no-provocation "otherwise than on grave and sudden provocation given by that person";
    quote q:403-movable "movable property";
    quote q:403-dishonestly "dishonestly";
    quote q:403-misappropriates "misappropriates";
    quote q:403-converts "converts to his own use";
    quote q:405-entrusted "entrusted with property, or with any dominion over property";
    quote q:405-dishonest-misappropriation "dishonestly misappropriates or converts to his own use that property";
    quote q:405-dishonest-use "dishonestly uses or disposes of that property in violation of a direction of law or legal contract";
    quote q:405-intentionally-suffers "intentionally suffers any other person to do so";
    quote q:411-receives "receives or retains any property";
    quote q:411-property-source "stolen property or property obtained in whole or in part through an offence involving fraud or dishonesty";
    quote q:411-knowledge "knowing or having reason to believe the property to be such property";
    quote q:441-entry "enters into or upon property in the possession of another";
    quote q:441-entry-intent-offence "intent to commit an offence";
    quote q:441-entry-intent-person "intent to intimidate, insult or annoy a person in possession";
    quote q:441-lawful-entry "having lawfully entered into or upon such property";
    quote q:441-remains "unlawfully remains there";
    quote q:441-remain-intent "intent thereby to intimidate, insult or annoy, or to commit an offence";
    quote q:339-obstruction "voluntarily obstructs any person";
    quote q:339-prevention "prevent that person from proceeding in any direction";
    quote q:339-right "in which that person has a right to proceed";
    quote q:79-override "unless otherwise provided by written law";
    quote q:79-act "an act is done by any person";
    quote q:79-mistake "by reason of a mistake of fact";
    quote q:79-ignorance "in ignorance of a fact";
    quote q:79-good-faith "in good faith believes himself bound by law or justified by law";
    quote q:80-accident "done by accident or misfortune";
    quote q:80-lawful-act "in the doing of a lawful act";
    quote q:80-lawful-manner "in a lawful manner";
    quote q:80-lawful-means "by lawful means";
    quote q:80-care "with proper care and caution";
    quote q:81-likely-harm "act likely to cause harm";
    quote q:81-knowledge "knowledge that it is likely to cause harm";
    quote q:81-good-faith "done in good faith";
    quote q:81-purpose "purpose of preventing or avoiding other harm to person or property";
    quote q:81-risk "harm sufficiently imminent to justify or excuse the risk";
    quote q:82-act "an act is done";
    quote q:82-child "child below 10 years of age";
  }

  annotations { burden section107 defence legal balance_of_probabilities; }
  scope-assumptions {
    scope-assumption a:bounded-section403-expression for o:misappropriation;
  }

  offence o:misappropriation rule r:section403 program p:section403 path section403 sections 403 {
    element movable-property f:403-movable-property quote q:403-movable;
    element dishonest-intention f:403-dishonesty quote q:403-dishonestly;
    element conduct f:403-misappropriates quote q:403-misappropriates;
    element conduct f:403-converts quote q:403-converts;
    any g:403-conduct (f:403-misappropriates, f:403-converts);
    all g:403-requirements (f:403-movable-property, f:403-dishonesty, g:403-conduct);
  }

  general-exception x:section79 rule r:section79 program p:section79 path section79 sections 79 {
    element circumstance f:79-no-written-law-override quote q:79-override;
    element conduct f:79-act-done quote q:79-act;
    element circumstance f:79-mistake-of-fact quote q:79-mistake;
    element circumstance f:79-ignorance-of-fact quote q:79-ignorance;
    element fault f:79-good-faith-belief quote q:79-good-faith;
    any g:79-factual-basis (f:79-mistake-of-fact, f:79-ignorance-of-fact);
    all g:79-requirements (f:79-no-written-law-override, f:79-act-done, g:79-factual-basis, f:79-good-faith-belief);
  }

  attach x:section79 to o:misappropriation;

  outputs {
    misappropriation_final r:section403;
    section_exception_defeat x:section79;
  }

  candidate-penalties {
    candidate pen:section403 for offence o:misappropriation source src:pc-release provision 403 { one-or-more-of term:403 { imprisonment term:403-prison minimum not-stated maximum 2 years; fine term:403-fine currency SGD minimum not-stated maximum unbounded; } }
  }

  limitations {
    "Saved-text research expressions only; statutory illustrations and judicial interpretation are contextual";
    "Section 336 is limited to the rash limb; the distinct negligent limb and its lower terms are deferred";
    "Section 352 is limited to assault under section 351 and the stated absence of grave and sudden provocation";
    "Section 411 is limited to subsection (1), excludes motor vehicles, and does not execute its reasonable-excuse defence";
    "Sections 79, 80, 81 and 82 are bounded general-exception expressions, not evidence findings";
    "Candidate penalty terms are not imposed sentences";
    "No legal-currency, evidence, guilt, conviction, acquittal, sentence or procedure determination";
  }
}
