// Yuho Haskell Research Language v0.1: bounded saved-text expressions only.
model SingaporePenalCodeResearchReleaseResearchPrototype-v1 {
  variant SuppliedProofStatus-v1;
  jurisdiction Singapore;
  purpose research_prototype;
  request R01;
  policy 2026-09-13 1024;

  provenance {
    source src:pc-release source_text "library/penal_code/_raw/act.json and saved section statute.yh files";
    source src:release-status synthetic_status "research/singapore/research-release/synthetic classifications";
    quote q:336-act "does any act";
    quote q:336-rash "so rashly as to endanger human life or the personal safety of others";
    quote q:351-gesture "makes any gesture or any preparation";
    quote q:351-intention "intending that such gesture or preparation will cause apprehension of imminent criminal force";
    quote q:351-knowledge "knowing it to be likely that such gesture or preparation will cause apprehension of imminent criminal force";
    quote q:351-apprehension "cause any person present to apprehend imminent use of criminal force";
    quote q:352-no-provocation "otherwise than on grave and sudden provocation given by that person";
    quote q:403-movable "movable property";
    quote q:403-dishonestly "dishonestly";
    quote q:403-misappropriates "misappropriates";
    quote q:403-converts "converts to his own use";
    quote q:405-entrusted "entrusted with property, or with any dominion over property";
    quote q:405-dishonest-misappropriation "dishonestly misappropriates or converts to his own use that property";
    quote q:405-dishonest-use "dishonestly uses or disposes of that property in violation of a direction of law or legal contract";
    quote q:405-intentionally-suffers "intentionally suffers any other person to do so";
    quote q:411-receives "receives or retains any property";
    quote q:411-property-source "stolen property or property obtained in whole or in part through an offence involving fraud or dishonesty";
    quote q:411-knowledge "knowing or having reason to believe the property to be such property";
    quote q:441-entry "enters into or upon property in the possession of another";
    quote q:441-entry-intent-offence "intent to commit an offence";
    quote q:441-entry-intent-person "intent to intimidate, insult or annoy a person in possession";
    quote q:441-lawful-entry "having lawfully entered into or upon such property";
    quote q:441-remains "unlawfully remains there";
    quote q:441-remain-intent "intent thereby to intimidate, insult or annoy, or to commit an offence";
    quote q:339-obstruction "voluntarily obstructs any person";
    quote q:339-prevention "prevent that person from proceeding in any direction";
    quote q:339-right "in which that person has a right to proceed";
    quote q:79-override "unless otherwise provided by written law";
    quote q:79-act "an act is done by any person";
    quote q:79-mistake "by reason of a mistake of fact";
    quote q:79-ignorance "in ignorance of a fact";
    quote q:79-good-faith "in good faith believes himself bound by law or justified by law";
    quote q:80-accident "done by accident or misfortune";
    quote q:80-lawful-act "in the doing of a lawful act";
    quote q:80-lawful-manner "in a lawful manner";
    quote q:80-lawful-means "by lawful means";
    quote q:80-care "with proper care and caution";
    quote q:81-likely-harm "act likely to cause harm";
    quote q:81-knowledge "knowledge that it is likely to cause harm";
    quote q:81-good-faith "done in good faith";
    quote q:81-purpose "purpose of preventing or avoiding other harm to person or property";
    quote q:81-risk "harm sufficiently imminent to justify or excuse the risk";
    quote q:82-act "an act is done";
    quote q:82-child "child below 10 years of age";
  }

  annotations { burden section107 defence legal balance_of_probabilities; }
  scope-assumptions {
    scope-assumption a:bounded-rash-section336-expression for o:rash-endangerment;
    scope-assumption a:bounded-sections351-352-assault-expression for o:assault;
    scope-assumption a:bounded-section403-expression for o:misappropriation;
    scope-assumption a:bounded-sections405-406-expression for o:criminal-breach-of-trust;
    scope-assumption a:bounded-section411-subsection1-non-motor-expression for o:receiving-property;
    scope-assumption a:bounded-sections441-447-expression for o:criminal-trespass;
    scope-assumption a:bounded-sections339-341-expression for o:wrongful-restraint;
  }

  offence o:rash-endangerment rule r:section336-rash program p:section336-rash path section336-rash sections 336 {
    element conduct f:336-doing-act quote q:336-act;
    element fault f:336-rashness quote q:336-rash;
    all g:336-rash-requirements (f:336-doing-act, f:336-rashness);
  }

  offence o:assault rule r:section352-assault program p:section352-assault path sections351-352 sections 351,352 {
    element conduct f:351-gesture-or-preparation quote q:351-gesture;
    element intention f:351-intention quote q:351-intention;
    element knowledge f:351-knowledge quote q:351-knowledge;
    element circumstance f:351-apprehension quote q:351-apprehension;
    element circumstance f:352-no-grave-sudden-provocation quote q:352-no-provocation;
    any g:351-fault (f:351-intention, f:351-knowledge);
    all g:352-assault-requirements (f:351-gesture-or-preparation, g:351-fault, f:351-apprehension, f:352-no-grave-sudden-provocation);
  }

  offence o:misappropriation rule r:section403 program p:section403 path section403 sections 403 {
    element movable-property f:403-movable-property quote q:403-movable;
    element dishonest-intention f:403-dishonesty quote q:403-dishonestly;
    element conduct f:403-misappropriates quote q:403-misappropriates;
    element conduct f:403-converts quote q:403-converts;
    any g:403-conduct (f:403-misappropriates, f:403-converts);
    all g:403-requirements (f:403-movable-property, f:403-dishonesty, g:403-conduct);
  }

  offence o:criminal-breach-of-trust rule r:section406 program p:section406 path sections405-406 sections 405,406 {
    element circumstance f:405-entrustment-or-dominion quote q:405-entrusted;
    element conduct f:405-dishonest-misappropriation quote q:405-dishonest-misappropriation;
    element conduct f:405-dishonest-use-disposal quote q:405-dishonest-use;
    element conduct f:405-intentionally-suffers quote q:405-intentionally-suffers;
    any g:405-dealing-route (f:405-dishonest-misappropriation, f:405-dishonest-use-disposal, f:405-intentionally-suffers);
    all g:405-requirements (f:405-entrustment-or-dominion, g:405-dealing-route);
  }

  offence o:receiving-property rule r:section411 program p:section411 path section411 sections 410,411 {
    element conduct f:411-receives-or-retains quote q:411-receives;
    element circumstance f:411-qualifying-property quote q:411-property-source;
    element knowledge f:411-knows-or-reason quote q:411-knowledge;
    all g:411-requirements (f:411-receives-or-retains, f:411-qualifying-property, f:411-knows-or-reason);
  }

  offence o:criminal-trespass rule r:section447 program p:section447 path sections441-447 sections 441,447 {
    element conduct f:441-entry quote q:441-entry;
    element intention f:441-entry-intent-offence quote q:441-entry-intent-offence;
    element intention f:441-entry-intent-person quote q:441-entry-intent-person;
    element circumstance f:441-lawful-entry quote q:441-lawful-entry;
    element conduct f:441-unlawfully-remains quote q:441-remains;
    element intention f:441-remain-intent quote q:441-remain-intent;
    any g:441-entry-purpose (f:441-entry-intent-offence, f:441-entry-intent-person);
    all g:441-entry-route (f:441-entry, g:441-entry-purpose);
    all g:441-remain-route (f:441-lawful-entry, f:441-unlawfully-remains, f:441-remain-intent);
    any g:441-requirements (g:441-entry-route, g:441-remain-route);
  }

  offence o:wrongful-restraint rule r:section341 program p:section341 path sections339-341 sections 339,341 {
    element conduct f:339-obstruction quote q:339-obstruction;
    element result f:339-prevention quote q:339-prevention;
    element circumstance f:339-right-to-proceed quote q:339-right;
    all g:339-requirements (f:339-obstruction, f:339-prevention, f:339-right-to-proceed);
  }

  general-exception x:section79 rule r:section79 program p:section79 path section79 sections 79 {
    element circumstance f:79-no-written-law-override quote q:79-override;
    element conduct f:79-act-done quote q:79-act;
    element circumstance f:79-mistake-of-fact quote q:79-mistake;
    element circumstance f:79-ignorance-of-fact quote q:79-ignorance;
    element fault f:79-good-faith-belief quote q:79-good-faith;
    any g:79-factual-basis (f:79-mistake-of-fact, f:79-ignorance-of-fact);
    all g:79-requirements (f:79-no-written-law-override, f:79-act-done, g:79-factual-basis, f:79-good-faith-belief);
  }

  general-exception x:section80 rule r:section80 program p:section80 path section80 sections 80 {
    element circumstance f:80-accident-or-misfortune quote q:80-accident;
    element circumstance f:80-lawful-act quote q:80-lawful-act;
    element circumstance f:80-lawful-manner quote q:80-lawful-manner;
    element circumstance f:80-lawful-means quote q:80-lawful-means;
    element circumstance f:80-proper-care-caution quote q:80-care;
    all g:80-requirements (f:80-accident-or-misfortune, f:80-lawful-act, f:80-lawful-manner, f:80-lawful-means, f:80-proper-care-caution);
  }

  general-exception x:section81 rule r:section81 program p:section81 path section81 sections 81 {
    element conduct f:81-act-likely-harm quote q:81-likely-harm;
    element knowledge f:81-knowledge-likely-harm quote q:81-knowledge;
    element fault f:81-good-faith quote q:81-good-faith;
    element purpose f:81-preventive-purpose quote q:81-purpose;
    element circumstance f:81-justified-risk quote q:81-risk;
    all g:81-requirements (f:81-act-likely-harm, f:81-knowledge-likely-harm, f:81-good-faith, f:81-preventive-purpose, f:81-justified-risk);
  }

  general-exception x:section82 rule r:section82 program p:section82 path section82 sections 82 {
    element conduct f:82-act-done quote q:82-act;
    element circumstance f:82-child-below-10 quote q:82-child;
    all g:82-requirements (f:82-act-done, f:82-child-below-10);
  }

  attach x:section80 to o:rash-endangerment;
  attach x:section81 to o:assault;
  attach x:section79 to o:misappropriation;
  attach x:section82 to o:criminal-breach-of-trust;
  attach x:section79 to o:receiving-property;
  attach x:section80 to o:criminal-trespass;
  attach x:section81 to o:wrongful-restraint;

  outputs {
    rash_final r:section336-rash;
    assault_final r:section352-assault;
    misappropriation_final r:section403;
    cbt_final r:section406;
    receiving_final r:section411;
    trespass_final r:section447;
    restraint_final r:section341;
    section79_defeat x:section79;
    section80_defeat x:section80;
    section81_defeat x:section81;
    section82_defeat x:section82;
  }

  candidate-penalties {
    candidate pen:section336-rash for offence o:rash-endangerment source src:pc-release provision 336 { one-or-more-of term:336-rash { imprisonment term:336-prison minimum not-stated maximum 6 months; fine term:336-fine currency SGD minimum not-stated maximum 2500; } }
    candidate pen:section352 for offence o:assault source src:pc-release provision 352 { one-or-more-of term:352 { imprisonment term:352-prison minimum not-stated maximum 3 months; fine term:352-fine currency SGD minimum not-stated maximum 1500; } }
    candidate pen:section403 for offence o:misappropriation source src:pc-release provision 403 { one-or-more-of term:403 { imprisonment term:403-prison minimum not-stated maximum 2 years; fine term:403-fine currency SGD minimum not-stated maximum unbounded; } }
    candidate pen:section406 for offence o:criminal-breach-of-trust source src:pc-release provision 406 { one-or-more-of term:406 { imprisonment term:406-prison minimum not-stated maximum 7 years; fine term:406-fine currency SGD minimum not-stated maximum unbounded; } }
    candidate pen:section411 for offence o:receiving-property source src:pc-release provision 411 { one-or-more-of term:411 { imprisonment term:411-prison minimum not-stated maximum 5 years; fine term:411-fine currency SGD minimum not-stated maximum unbounded; } }
    candidate pen:section447 for offence o:criminal-trespass source src:pc-release provision 447 { one-or-more-of term:447 { imprisonment term:447-prison minimum not-stated maximum 3 months; fine term:447-fine currency SGD minimum not-stated maximum 1500; } }
    candidate pen:section341 for offence o:wrongful-restraint source src:pc-release provision 341 { one-or-more-of term:341 { imprisonment term:341-prison minimum not-stated maximum 1 months; fine term:341-fine currency SGD minimum not-stated maximum 1500; } }
  }

  limitations {
    "Saved-text research expressions only; statutory illustrations and judicial interpretation are contextual";
    "Section 336 is limited to the rash limb; the distinct negligent limb and its lower terms are deferred";
    "Section 352 is limited to assault under section 351 and the stated absence of grave and sudden provocation";
    "Section 411 is limited to subsection (1), excludes motor vehicles, and does not execute its reasonable-excuse defence";
    "Sections 79, 80, 81 and 82 are bounded general-exception expressions, not evidence findings";
    "Candidate penalty terms are not imposed sentences";
    "No legal-currency, evidence, guilt, conviction, acquittal, sentence or procedure determination";
  }
}
